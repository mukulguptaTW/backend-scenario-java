{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "PetClinic REST API — request rate, error rate, p95 latency, JVM memory & CPU",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "description": "Total HTTP requests per second across all endpoints (5-minute rate window).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"petclinic-rest\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 2,
      "title": "Error Rate (5xx ratio)",
      "description": "Fraction of requests that returned a 5xx status (0 = no errors, 1 = 100% errors). Uses percentunit so Grafana renders 0.02 as 2%.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red",    "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"petclinic-rest\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"petclinic-rest\"}[5m]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 3,
      "title": "P95 Latency (seconds)",
      "description": "95th-percentile response time across all endpoints. Uses histogram_quantile() over 5-minute bucket rate. Unit is seconds.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red",    "value": 1.0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"petclinic-rest\"}[5m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    },

    {
      "id": 4,
      "title": "Saturation — JVM Heap Memory & CPU Usage",
      "description": "Two saturation signals in one panel. Heap memory (bytes, left axis) shows how much heap the JVM is consuming. CPU usage (percentunit, right axis) shows the JVM process CPU fraction (0–1). Watch for heap growing without GC drops, or CPU spiking under load.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU Usage" },
            "properties": [
              { "id": "unit",   "value": "percentunit" },
              { "id": "min",    "value": 0 },
              { "id": "max",    "value": 1 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel",     "value": "CPU (0–1)" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Heap Memory" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "left" },
              { "id": "custom.axisLabel",     "value": "Heap Bytes" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(jvm_memory_used_bytes{application=\"petclinic-rest\", area=\"heap\"})",
          "legendFormat": "Heap Memory",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "process_cpu_usage{application=\"petclinic-rest\"}",
          "legendFormat": "CPU Usage",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
    }

  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [ "petclinic", "spring-boot", "prometheus" ],
  "templating": {
    "list": [
      {
        "hide": 2,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PetClinic REST API",
  "uid": "petclinic-rest-001",
  "version": 1
}
